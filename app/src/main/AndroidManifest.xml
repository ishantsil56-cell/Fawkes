<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone: listening at all. Asked for on first launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera: flashlight only, no photos. Asked for on first launch. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Contacts: calling / texting people by name. Asked for on first launch. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Notifications: reminders and the wake-word "I heard you" alert. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarms: reminders fire on time. Granted in system settings. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Foreground service (microphone): the "Hey Fawkes" wake word. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Boot: re-schedule reminders and restart the wake word after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Brightness: granted in system settings the first time it's used. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- INTERNET is used ONLY for the one-time voice-model downloads
         (English ~41 MB, Hindi ~44 MB, from alphacephei.com) and for an
         optional direct LLM-model download. No voice audio or any other
         data ever leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- App visibility: opening apps by name, and WhatsApp by package. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.whatsapp" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fawkes">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".voice.ModelDownloadActivity"
            android:exported="false"
            android:label="@string/download_title" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.HelpActivity"
            android:exported="false"
            android:label="@string/help_title" />

        <service
            android:name=".voice.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".receivers.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.FawkesWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".widget.ListenTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
